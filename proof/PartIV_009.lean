  have hHcoef:∀j,0≤ Hcoef j:=by intro j;dsimp [Hcoef];positivity
  have hKmain:0≤ Kmain:=by unfold Kmain mainRadius mainCommonRadius;positivity
  have hKerror:∀prime i χ,0≤ Kerror prime i χ:=by
